{
  "name": "family-tree-backend",
  "imports": {
    "#*": "./src/*",
    "#config*": "./src/config/*",
    "#infra*": "./src/infra/*",
    "#modules*": "./src/modules/*",
    "#shared*": "./src/shared/*",
    "#utils*": "./src/utils/*",
    "#api*": "./src/modules/api/*",
    "#controllers*": "./src/shared/controllers/*",
    "#middleware*": "./src/shared/middleware/*",
    "#services*": "./src/shared/services/*",
    "#types*": "./src/shared/types/*",
    "#constants*": "./src/constants/*"
  },
  "version": "1.0.0",
  "description": "",
  "main": "app.ts",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/app.ts",
    "dev": "nodemon --watch src --ext ts --exec \"node --no-deprecation --trace-warnings --trace-uncaught src/app.ts\"",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\""
  },
  "author": "Damanski Dzmitry",
  "license": "ISC",
